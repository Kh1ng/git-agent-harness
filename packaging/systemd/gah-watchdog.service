# gah-watchdog.service
#
# Issue #726: alert-only health check for gah-loop@<profile>.service units.
# `gah watchdog-check` is read-only by construction -- it only ever runs
# `systemctl --user show <unit> --property=... --value`, a query, and never
# `systemctl start`/`restart`/`enable`, `gah loop`, or any HTTP endpoint. A
# stopped or crashed loop produces at most a notification here; nothing in
# this unit or the command it runs is capable of starting a loop.
#
# The operator/dashboard is the ONLY start path
# (`systemctl --user start gah-loop@<profile>`, or the dashboard's
# equivalent). This unit exists to make an unattended stop/crash visible to a
# human, not to recover from one.
#
# `gah update`/`scripts/install.sh` install this template deterministically
# and reload the user systemd manager, but deliberately never `enable` or
# `start` the paired timer -- opt in explicitly once you've configured an
# alert command:
#   systemctl --user enable --now gah-watchdog.timer
#
# The packaged check writes alerts to the journal. To forward alerts, configure
# ExecStart in a systemctl --user edit drop-in using your installed transport.
[Unit]
Description=GAH loop health check (alert-only, never starts a loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=HOME=%h
Environment=GAH_CONFIG=%h/.config/gah/config.toml
Environment="PATH=@PATH@"
ExecStart="@GAH@" watchdog-check
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=timers.target
