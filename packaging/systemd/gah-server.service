# gah-server.service
# Runs apps/server (the REST/WebSocket API the dashboard talks to) as a
# persistent background service.
#
# IMPORTANT: the PATH below is required, not cosmetic. apps/server shells
# out to `gah dispatch`, which in turn runs each profile's
# `validation_commands` (typically `cargo fmt/clippy/test`, `npm ci`,
# `npx tsc`, ...) as child processes. A systemd service's default PATH does
# not include a rustup/nvm-managed toolchain's bin directories, so any
# dispatch triggered through the dashboard's WebSocket "Dispatch new work"
# form silently fails baseline validation with `cargo: not found` (or the
# npm/npx equivalent) unless PATH is set explicitly here -- read-only CLI
# calls (`gah status`, `gah report`, ...) don't need this and will appear
# to work fine even when it's missing, which is what let this go unnoticed.
# The placeholders between `@` signs below are host values (user, home, checkout, Cargo and
# Node bin directories); `gah update --role central` fills them in for the
# machine it runs on.
#
# HOST/PORT (issue #643): the app defaults HOST to 0.0.0.0 and PORT to 3773.
# Override either persistently by writing /etc/gah/server.env (not tracked in
# this repo) rather than editing this unit -- `scripts/install.sh` creates it
# on first install and never overwrites it afterward, and `gah update
# --restart-server` never touches it either, so an operator's HOST choice
# (loopback, one interface, or 0.0.0.0) survives every reinstall/update.
# Example /etc/gah/server.env:
#   HOST=127.0.0.1
#
# Install: `gah update --role central` renders this template and installs it
# to /etc/systemd/system. Do not copy it by hand; the placeholders must be filled.
[Unit]
Description=Git Agent Harness API and WebSocket server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@GAH_USER@
WorkingDirectory=@GAH_REPO@
Environment=NODE_ENV=production
Environment=PORT=3773
Environment=GAH_CONFIG_PATH=@GAH_HOME@/.config/gah/config.toml
Environment=PATH=@GAH_CARGO_BIN@:@GAH_NODE_BIN@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional persistent override file; the leading "-" means systemd does not
# fail the unit if it doesn't exist. Values here win over the Environment=
# lines above since it's read after them.
EnvironmentFile=-/etc/gah/server.env
ExecStart=@GAH_NODE_BIN@/node apps/server/dist/bin.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
