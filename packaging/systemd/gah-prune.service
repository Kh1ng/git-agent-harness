# gah-prune.service
# Prunes stale GAH worktrees and sessions for every configured profile.
#
# `gah prune` with no --profile prunes ALL profiles; each profile applies its
# own per-profile `prune_older_than_days` retention window (falling back to the
# 30-day default when unset). Merged/closed PR/MR worktrees are always pruned,
# regardless of the retention window.
# The second command settles terminal chat sessions and archives idle ones by
# calling the server package's shared maintenance path. Both commands remain
# on this one existing daily timer; no chat-specific scheduler is created.
#
# This is a template: the placeholders between `@` signs are host values (checkout, Cargo
# and Node bin directories) that `gah update --role central` fills in when it
# installs this user unit and enables the timer. Do not copy it by hand.
[Unit]
Description=GAH prune — remove stale worktrees and sessions for all profiles
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@GAH_REPO@
Environment=GAH_CONFIG_PATH=%h/.config/gah/config.toml
Environment=PATH=@GAH_CARGO_BIN@:@GAH_NODE_BIN@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PORT=3773
# The maintenance HTTP request uses HOST/PORT and sends COORDINATOR_TOKEN.
# Wildcard HOST values use loopback, which needs no token. A specific remote
# interface requires the token and explicit GAH_ALLOW_INSECURE_HTTP=1 because
# this command connects directly over HTTP, not through a TLS reverse proxy.
EnvironmentFile=-/etc/gah/server.env
ExecStart=@GAH_CARGO_BIN@/gah prune
ExecStart=/usr/bin/env node apps/server/dist/chatMaintenanceCli.js
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
