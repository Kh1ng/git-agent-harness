{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAH Worker",
  "version": "0.1.0",
  "identifier": "com.kh1ng.gah-worker",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main application capabilities",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-close"
          ]
        },
        {
          "identifier": "tray",
          "description": "System tray capabilities",
          "permissions": [
            "core:tray:allow-new",
            "core:tray:allow-set-icon",
            "core:tray:allow-set-title",
            "core:tray:allow-set-tooltip",
            "core:tray:allow-set-menu",
            "core:tray:allow-set-visible"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "GAH Dashboard",
        "url": "http://100.118.97.79",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false
      }
    ]
  },
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://100.118.97.79"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}
