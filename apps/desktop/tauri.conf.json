{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAH",
  "version": "0.1.1",
  "identifier": "com.kh1ng.gah-worker",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "local-settings",
          "description": "Bundled Settings page only; remote dashboards cannot operate this computer",
          "windows": [
            "dashboard"
          ],
          "permissions": [
            "core:default",
            "allow-desktop-settings",
            "allow-save-presence",
            "allow-connect-dashboard",
            "allow-open-central-settings",
            "allow-node-role-status",
            "allow-set-node-role",
            "allow-worker-status",
            "allow-set-worker-running"
          ],
          "local": true
        }
      ]
    },
    "windows": []
  },
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm exec vite -- --port 1420 --strictPort"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    }
  }
}
